local lastItemsShopBuyTime = 0
local cachedFallbackCatalog = nil

local function autoBuyItemsShop()
    if not Config.AutoBuyItemsShop then return end
    local now = os.clock()
    if now - lastItemsShopBuyTime < 1.0 then return end
    lastItemsShopBuyTime = now

    pcall(function()
        local GearShopModel = require(ReplicatedStorage.UI.GearShop.Model.GearShopModel)
        if not GearShopModel then return end

        if not GearShopModel.Initialized and GearShopModel.Init then
            GearShopModel:Init()
        end

        local catalog = nil
        if GearShopModel.GetCatalog then
            catalog = GearShopModel:GetCatalog()
        end

        -- Fallback แคชรายการไอเทมทั้งหมดจาก ui_tbbackpackitem เพียงครั้งเดียว (ไม่สร้างตารางใหม่ซ้ำๆ)
        if not catalog or #catalog == 0 then
            if not cachedFallbackCatalog then
                local tbItem = require(ReplicatedStorage._genConfigs.ui_tbbackpackitem)
                if tbItem then
                    cachedFallbackCatalog = {}
                    for id, cfg in pairs(tbItem) do
                        if type(cfg) == loadstring(base64decode("dGFibGU="))() and cfg.Tag ~= loadstring(base64decode("RXZlbnRJdGVt"))() and cfg.CoinPrice and cfg.CoinPrice > 0 then
                            table.insert(cachedFallbackCatalog, { ItemId = id, Config = cfg })
                        end
                    end
                    table.sort(cachedFallbackCatalog, function(a, b)
                        local sA = tonumber(a.Config.sort or a.Config.Index) or 99
                        local sB = tonumber(b.Config.sort or b.Config.Index) or 99
                        return sA < sB
                    end)
                end
            end
            catalog = cachedFallbackCatalog
        end

        if not catalog or #catalog == 0 then return end

        local currentGold = getCurrentPlayerGold()
        local boughtCount = 0

        for _, itemEntry in ipairs(catalog) do
            local itemId = itemEntry.ItemId
            local cfg = itemEntry.Config or {}
            local price = tonumber(cfg.CoinPrice) or 0

            -- ตรวจสอบว่า loadstring(base64decode("4LiV4Lix4LiH4LiE4LmM4Lie4Lit4LiL4Li34LmJ4Lit"))() หรือไม่ (เหมาทุกอย่างที่เงินพอ)
            if price > 0 and currentGold >= price then
                local stock = (GearShopModel.GetStock and GearShopModel:GetStock(itemId)) or 1
                local isPending = (GearShopModel.IsPending and GearShopModel:IsPending(itemId)) or false

                if stock > 0 and not isPending then
                    local bought = false

                    -- 1. สั่งซื้อผ่าน GearShopModel ของตัวเกม
                    if GearShopModel.Purchase then
                        bought = GearShopModel:Purchase(itemId)
                    end

                    -- 2. ยิงตรงผ่าน EventBus Network Command
                    local EventBus = require(ReplicatedStorage.Packages.EventBus)
                    local GearShopConfig = require(ReplicatedStorage.Configs.GearShopConfig)
                    if EventBus and GearShopConfig then
                        EventBus.FireServer(GearShopConfig.RequestEvent, { Action = loadstring(base64decode("UHVyY2hhc2U="))(), ItemId = itemId })
                        bought = true
                    end

                    -- 3. คลิกปุ่ม BuyBtn บน GUI (สำรองเพื่อความชัวร์ 100%)
                    pcall(function()
                        local hud = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))()) and LocalPlayer.PlayerGui:FindFirstChild(loadstring(base64decode("SFVEQ29udGFpbmVy"))())
                        local shopFrame = hud and hud:FindFirstChild(loadstring(base64decode("R2VhclNob3BGcmFtZQ=="))())
                        local scroll = shopFrame and shopFrame:FindFirstChild(loadstring(base64decode("U2Nyb2xsaW5nRnJhbWU="))())
                        local card = scroll and scroll:FindFirstChild(itemId)
                        local buyBtn = card and card:FindFirstChild(loadstring(base64decode("QnV5QnRu"))())
                        if buyBtn and firesignal then
                            firesignal(buyBtn.Activated)
                        end
                    end)

                    if bought then
                        currentGold = currentGold - price
                        Config.Stats.TotalItemsBought = (Config.Stats.TotalItemsBought or 0) + 1
                        Config.Stats.TotalShopGoldSpent = (Config.Stats.TotalShopGoldSpent or 0) + price
                        boughtCount = boughtCount + 1
                        task.wait(0.12)
                    end
                end
            end
        end

        if boughtCount > 0 and GearShopModel.RequestSnapshot then
            GearShopModel:RequestSnapshot()
        end
    end)
end


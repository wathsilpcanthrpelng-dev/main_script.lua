-- 9.10. AUTO UNLOCK ANT HOLE (ปลดล็อครูมดในรังออโต้เมื่อตังค์พอ)
-- ══════════════════════════════════════════════════════════════════
local function parsePriceString(str)
    if not str then return nil end
    local s = tostring(str)
    local directNum = tonumber(s)
    if directNum then return directNum end
    local clean = string.gsub(s, loadstring(base64decode("WywlJCVzXQ=="))(), loadstring(base64decode(""))())
    local numPart, unit = string.match(clean, loadstring(base64decode("XihbJWQlLl0rKSVzKihbQS1aYS16XSopJA=="))())
    if numPart then
        local val = tonumber(numPart) or 0
        unit = string.upper(unit or loadstring(base64decode(""))())
        if unit == loadstring(base64decode("Sw=="))() then val = val * 1e3
        elseif unit == loadstring(base64decode("TQ=="))() then val = val * 1e6
        elseif unit == loadstring(base64decode("Qg=="))() then val = val * 1e9
        elseif unit == loadstring(base64decode("VA=="))() then val = val * 1e12
        elseif unit == loadstring(base64decode("UUE="))() then val = val * 1e15
        elseif unit == loadstring(base64decode("UUk="))() then val = val * 1e18
        end
        return val
    end
    return nil
end

local function findNextBuyableAntSlot()
    local roomIdx = tonumber(LocalPlayer:GetAttribute(loadstring(base64decode("Um9vbUluZGV4"))()) or 1) or 1
    local room = Workspace:FindFirstChild(loadstring(base64decode("Um9vbXM="))()) and Workspace.Rooms:FindFirstChild(tostring(roomIdx))
    
    local foundSlotIndex = nil
    local foundPrompt = nil
    local foundPrice = nil
    
    -- 1. Scan player room's AntPos for slot instance with SlotBuyable == true
    if room and room:FindFirstChild(loadstring(base64decode("QW50UG9z"))()) then
        local buyableSlots = {}
        for _, child in ipairs(room.AntPos:GetChildren()) do
            local idx = tonumber(child.Name)
            if idx and child:GetAttribute(loadstring(base64decode("U2xvdEJ1eWFibGU="))()) == true then
                table.insert(buyableSlots, { SlotIndex = idx, Object = child })
            end
            for _, subChild in ipairs(child:GetChildren()) do
                local subIdx = tonumber(subChild.Name)
                if subIdx and subChild:GetAttribute(loadstring(base64decode("U2xvdEJ1eWFibGU="))()) == true then
                    table.insert(buyableSlots, { SlotIndex = subIdx, Object = subChild })
                end
            end
        end
        if #buyableSlots > 0 then
            table.sort(buyableSlots, function(a, b) return a.SlotIndex < b.SlotIndex end)
            foundSlotIndex = buyableSlots[1].SlotIndex
            local p = buyableSlots[1].Object:FindFirstChildWhichIsA(loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))(), true)
            if p then foundPrompt = p end
        end
    end
    
    -- 2. Scan for any ProximityPrompt in the room with ActionText == loadstring(base64decode("VW5sb2Nr"))() or inside AddAntNum
    if room then
        for _, desc in ipairs(room:GetDescendants()) do
            if desc:IsA(loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))()) then
                local action = string.lower(desc.ActionText or loadstring(base64decode(""))())
                local name = string.lower(desc.Name or loadstring(base64decode(""))())
                local parentName = string.lower(desc.Parent and desc.Parent.Name or loadstring(base64decode(""))())
                if action == loadstring(base64decode("dW5sb2Nr"))() or name == loadstring(base64decode("dW5sb2NrcHJvbXB0"))() or string.find(parentName, loadstring(base64decode("YWRkYW50bnVt"))()) then
                    foundPrompt = desc
                    if not foundPrice and desc.ObjectText then
                        foundPrice = parsePriceString(desc.ObjectText)
                    end
                    if not foundSlotIndex then
                        local pObj = desc.Parent
                        while pObj and pObj ~= room do
                            local n = tonumber(pObj.Name)
                            if n and n > 0 and n <= 45 then
                                foundSlotIndex = n
                                break
                            end
                            pObj = pObj.Parent
                        end
                    end
                end
            end
        end
    end
    
    -- 3. Fallback slot index using player attributes or config
    local maxSlotsAttr = tonumber(LocalPlayer:GetAttribute(loadstring(base64decode("TWF4QW50U2xvdHM="))()))
    if not foundSlotIndex then
        if maxSlotsAttr and maxSlotsAttr > 0 then
            foundSlotIndex = maxSlotsAttr + 1
        else
            foundSlotIndex = 2
        end
    end
    
    -- 4. Determine price
    if not foundPrice or foundPrice <= 0 then
        local cfg = (battle_tbnestunlock and (battle_tbnestunlock[foundSlotIndex] or battle_tbnestunlock[maxSlotsAttr or 1]))
        if cfg and cfg.Price then
            foundPrice = tonumber(cfg.Price) or 0
        end
    end
    
    return {
        RoomIndex = roomIdx,
        SlotIndex = foundSlotIndex,
        Prompt = foundPrompt,
        Price = foundPrice or 0
    }
end

local function getAntHoleStatus()
    local roomIdx = tonumber(LocalPlayer:GetAttribute(loadstring(base64decode("Um9vbUluZGV4"))()) or 1) or 1
    local currentSlots = tonumber(LocalPlayer:GetAttribute(loadstring(base64decode("TWF4QW50U2xvdHM="))())) or 0
    local target = findNextBuyableAntSlot()
    local slotIdx = target and target.SlotIndex or (currentSlots + 1)
    local price = target and target.Price or 0
    if price <= 0 and battle_tbnestunlock and battle_tbnestunlock[slotIdx] then
        price = tonumber(battle_tbnestunlock[slotIdx].Price) or 0
    end
    local currentGold = getCurrentPlayerGold()
    local canAfford = (price > 0 and currentGold >= price) or (price == 0)
    return {
        RoomIndex = roomIdx,
        CurrentSlots = currentSlots,
        NextSlot = slotIdx,
        Price = price,
        CurrentGold = currentGold,
        CanAfford = canAfford,
        IsMax = (currentSlots >= 45 or slotIdx > 45)
    }
end


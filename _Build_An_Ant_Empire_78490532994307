local function clickGuiButton(btn)
    if not btn then return false end
    local clicked = false

    -- Method 1: firesignal (Executor API)
    if firesignal then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.MouseButton1Down)
        pcall(firesignal, btn.MouseButton1Up)
        pcall(firesignal, btn.Activated)
        clicked = true
    end

    -- Method 2: VirtualInputManager (Hardware mouse click simulation)
    if VirtualInputManager and btn.AbsolutePosition and btn.AbsoluteSize then
        pcall(function()
            local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            if center.X > 0 and center.Y > 0 then
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
                clicked = true
            end
        end)
    end

    -- Method 3: VirtualUser (Fallback)
    if not clicked and VirtualUser and btn.AbsolutePosition and btn.AbsoluteSize then
        pcall(function()
            local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            VirtualUser:Button1Down(Vector2.new(center.X, center.Y), Workspace.CurrentCamera.CFrame)
            task.wait(0.03)
            VirtualUser:Button1Up(Vector2.new(center.X, center.Y), Workspace.CurrentCamera.CFrame)
            clicked = true
        end)
    end

    return clicked
end


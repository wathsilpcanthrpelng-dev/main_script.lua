            if res and tonumber(res) then
                starCoins = math.max(starCoins, tonumber(res) or 0)
            end
        end
    end)

    -- 2. ดึงจาก ActivityEvent State
    pcall(function()
        local ActivityEventState = require(ReplicatedStorage.UI.ActivityEvent.Model.State)
        if ActivityEventState then
            if ActivityEventState.RefreshWishCurrencyBalance then
                ActivityEventState:RefreshWishCurrencyBalance()
            end
            local bal = ActivityEventState:GetWishCurrencyBalance()
            if bal and tonumber(bal) then
                starCoins = math.max(starCoins, tonumber(bal) or 0)
            end
        end
    end)

    -- 3. ตรวจสอบจาก GUI บนหน้าจอ (PlayerGui.HUDContainer.ActivityEvent)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))())
        local act = pg and pg:FindFirstChild(loadstring(base64decode("SFVEQ29udGFpbmVy"))()) and pg.HUDContainer:FindFirstChild(loadstring(base64decode("QWN0aXZpdHlFdmVudA=="))())
        if act then
            for _, desc in ipairs(act:GetDescendants()) do
                if desc:IsA(loadstring(base64decode("VGV4dExhYmVs"))()) and desc.Visible then
                    local txt = desc.Text or loadstring(base64decode(""))()
                    local num = string.match(txt, loadstring(base64decode("WW91ciBTdGFyIENvaW46JXMqKCVkKyk="))()) or (string.find(txt, loadstring(base64decode("U3RhciBDb2lu"))()) and string.match(txt, loadstring(base64decode("KCVkKyk="))()))
                    if num and tonumber(num) then
                        starCoins = math.max(starCoins, tonumber(num) or 0)
                    end
                end
            end
        end
    end)

    return starCoins
end


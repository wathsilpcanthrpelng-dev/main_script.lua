    didTrigger = true
    
    -- Layer 3: Click UI loadstring(base64decode("VW5sb2Nr"))() button in PlayerGui only if prompt window is open
    pcall(function()
        local pg = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))())
        local modalWindow = pg and (pg:FindFirstChild(loadstring(base64decode("Um9vbUFudEluZm9HdWk="))()) or pg:FindFirstChild(loadstring(base64decode("Q29tbW9uUHJvbXB0"))()) or pg:FindFirstChild(loadstring(base64decode("TW9kYWxQcm9tcHQ="))()))
        if modalWindow then
            for _, desc in ipairs(modalWindow:GetDescendants()) do
                if (desc:IsA(loadstring(base64decode("VGV4dEJ1dHRvbg=="))()) or desc:IsA(loadstring(base64decode("SW1hZ2VCdXR0b24="))())) and desc.Visible then
                    local p = desc.Parent
                    local isUnlockBtn = false
                    if string.lower(desc.Name) == loadstring(base64decode("aW1hZ2VidXR0b24="))() or string.find(string.lower(desc.Name), loadstring(base64decode("dW5sb2Nr"))()) then
                        local frame = p and p.Parent
                        if frame and frame:FindFirstChild(loadstring(base64decode("VGl0bGU="))()) and string.find(string.lower(frame.Title.Text or loadstring(base64decode(""))()), loadstring(base64decode("dW5sb2NrIGFudCBob2xl"))()) then
                            isUnlockBtn = true
                        end
                    end
                    if isUnlockBtn and firesignal then
                        pcall(firesignal, desc.Activated)
                    end
                end
            end
        end
    end)
    
    if didTrigger then
        Config.Stats.TotalAntHolesUnlocked = (Config.Stats.TotalAntHolesUnlocked or 0) + 1
        return true
    end
    return false
end


-- 9.8. RESOURCE CONVERTER AUTOMATION (เอาของใส่ก่อน ออกจากตัวที่น้อยที่สุดใส่ก่อน & ใส่พอดีกับที่ต้องการ)
-- ══════════════════════════════════════════════════════════════════
local lastCompostDepositTime = 0
local lastCompostPullTime = 0

-- ดึงสถานะปัจจุบันของตู้แปลงทรัพยากร (CompostCoin, NeedValue, RemainingNeeded, CanPull)
local function getCompostMachineStatus()
    local currentCoin = 0
    local needValue = 0
    local level = 1
    local canPull = false

    -- 1. ตรวจสอบผ่าน PlayerDataHelper
    pcall(function()
        local PlayerDataHelper = require(ReplicatedStorage.Battle.Game.Helper.PlayerDataHelper)
        if PlayerDataHelper then
            if PlayerDataHelper.GetPlayerCompostCoin then
                currentCoin = tonumber(PlayerDataHelper.GetPlayerCompostCoin(LocalPlayer.UserId)) or currentCoin
            end
            if PlayerDataHelper.GetPlayerCompostLevel then
                level = tonumber(PlayerDataHelper.GetPlayerCompostLevel(LocalPlayer.UserId)) or level
            end
            if PlayerDataHelper.GetCompostTierConfig then
                local cfg = PlayerDataHelper.GetCompostTierConfig(nil, level)
                if cfg and cfg.NeedValue then
                    needValue = tonumber(cfg.NeedValue) or needValue
                end
            end
        end
    end)

    -- 2. ตรวจสอบผ่านตาราง battle_tbcompostpool config database
    if needValue <= 0 then
        pcall(function()
            local poolCfg = battle_tbcompostpool and battle_tbcompostpool.CompostInfo and battle_tbcompostpool.CompostInfo.Info
            if poolCfg and poolCfg[level] and poolCfg[level].NeedValue then
                needValue = tonumber(poolCfg[level].NeedValue) or 0
            end
        end)
    end

    -- 3. ตรวจสอบผ่าน WuKong Query สำหรับ CompostCoin
    if currentCoin == 0 then
        pcall(function()
            local WuKong = require(ReplicatedStorage.WuKong)
            if WuKong and WuKong.ExecuteQuery then
                local q = tonumber(WuKong:ExecuteQuery(loadstring(base64decode("L+i1hOS6py/loIbogqXluIE/5bGe5oCn5pWw6YeP"))()))
                if q then currentCoin = q end
            end
        end)
    end

    -- 4. ตรวจสอบผ่าน CompostModel:GetState()
    pcall(function()
        local CompostModel = require(ReplicatedStorage.UI.Compost.Model.CompostModel)
        if CompostModel and CompostModel.GetState then
            local st = CompostModel:GetState()
            if st then
                if st.CompostCoin and st.CompostCoin > 0 then currentCoin = st.CompostCoin end
                if st.NeedValue and st.NeedValue > 0 then needValue = st.NeedValue end
                if st.CanPull ~= nil then canPull = st.CanPull end
            end
        end
    end)

    -- 5. Fallback: อ่านข้อความจาก GUI Progress.Amount เช่น loadstring(base64decode("JCAwIC8gJCAxMDBN"))()
    pcall(function()
        local hud = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))()) and LocalPlayer.PlayerGui:FindFirstChild(loadstring(base64decode("SFVEQ29udGFpbmVy"))())
        local machine = hud and hud:FindFirstChild(loadstring(base64decode("Q29tcG9zdE1hY2hpbmU="))())
        local amtLabel = machine and machine:FindFirstChild(loadstring(base64decode("TWFpbg=="))(), true) and machine.Main:FindFirstChild(loadstring(base64decode("UHJvZ3Jlc3M="))(), true) and machine.Main.Progress:FindFirstChild(loadstring(base64decode("QW1vdW50"))())
        if amtLabel and amtLabel.Text and amtLabel.Text ~= loadstring(base64decode(""))() then
            if amtLabel.Text == loadstring(base64decode("TWF4"))() then
                if needValue > 0 then currentCoin = needValue end
                canPull = true
            else
                local curStr, maxStr = amtLabel.Text:match(loadstring(base64decode("JSQqJXMqKFslZCUuXSslYSopJXMqLyVzKiUkKiVzKihbJWQlLl0rJWEqKQ=="))())
                if maxStr then
                    local parsedMax = parseFormattedCurrency(maxStr)
                    if parsedMax and parsedMax > 0 then needValue = parsedMax end
                end
                if curStr then
                    local parsedCur = parseFormattedCurrency(curStr)
                    if parsedCur and parsedCur > 0 then currentCoin = parsedCur end
                end
            end
        end
    end)

    if needValue > 0 and currentCoin >= needValue then
        canPull = true
    end

    local remainingNeeded = math.max(needValue - currentCoin, 0)
    return {
        CurrentCoin = currentCoin,
        NeedValue = needValue,
        RemainingNeeded = remainingNeeded,
        CanPull = canPull,
        Level = level
    }
end

local function depositAntsToCompostLowestFirst()
    if not Config.AutoCompostLowestFirst and not Config.AutoKaiTan then return end
    local now = os.clock()
    if now - lastCompostDepositTime < 1.0 then return end
    lastCompostDepositTime = now

    pcall(function()
        local status = getCompostMachineStatus()

        -- 1. ถ้าหลอดเต็มแล้ว หรือสามารถดึงคันโยกได้แล้ว (CompostCoin >= NeedValue หรือ CanPull)
        -- ห้ามใส่มดเพิ่มเด็ดขาด! ป้องกันการใส่มดเกินและสูญเสียมดไปโดยเปล่าประโยชน์
        if status.NeedValue > 0 and (status.RemainingNeeded <= 0 or status.CanPull) then
            if now - lastCompostPullTime >= 1.0 then
                lastCompostPullTime = now
                sendEcsCommand(loadstring(base64decode("Q29tcG9zdFB1bGxMZXZlcg=="))(), {})
                pcall(function()
                    local CompostModel = require(ReplicatedStorage.UI.Compost.Model.CompostModel)
                    if CompostModel and CompostModel.PullLever then
                        CompostModel:PullLever(nil)
                    end
                end)
                Config.Stats.TotalCompostLeversPulled = (Config.Stats.TotalCompostLeversPulled or 0) + 1
            end
            sendEcsCommand(loadstring(base64decode("Q2xhaW1BbnRSZXdhcmQ="))(), {})
            return
        end

        local BackpackModel = require(ReplicatedStorage.UI.Backpack.Model.BackpackModel)
        if not BackpackModel or not BackpackModel.BuildBackPackEntries then return end

        local entries = BackpackModel:BuildBackPackEntries()
        if not entries or #entries == 0 then return end

        local candidates = {}
        for _, entry in ipairs(entries) do
            if entry and entry.Kind == loadstring(base64decode("QW50"))() and not entry.Favorite and entry.V then
                local antEff = tonumber(entry.Attack) or 0
                local uIdx = 1
                if BackpackModel.DecodeBackpackValue then
                    local idx, tagId, exp = BackpackModel:DecodeBackpackValue(entry.V)
                    uIdx = idx or 1
                    if antEff <= 0 then
                        local uKey = loadstring(base64decode("VW5pdA=="))() .. tostring(uIdx)
                        local baseAtk = battle_tbunit[uKey] and battle_tbunit[uKey].Attack or 0
                        local tagMul = battle_tbtag[tagId] and battle_tbtag[tagId].Mul or 1
                        antEff = math.ceil(baseAtk * tagMul)
                    end
                end

                local price = (entry.UnitConfig and entry.UnitConfig.Price) or 0
                if price <= 0 then
                    local uKey = loadstring(base64decode("VW5pdA=="))() .. tostring(uIdx)
                    price = battle_tbunit[uKey] and tonumber(battle_tbunit[uKey].Price) or 0
                end
                if price <= 0 then price = 1000 end

                local level = entry.Level or 1
                local count = math.max(math.floor(tonumber(entry.Count) or 1), 1)

                table.insert(candidates, {
                    Entry = entry,
                    V = entry.V,
                    Count = count,
                    Power = antEff,
                    Price = price,
                    Level = level
                })
            end
        end

        if #candidates == 0 then return end

        -- จัดเรียงลำดับจาก loadstring(base64decode("4LiV4Lix4Lin4LiX4Li14LmI4LiZ4LmJ4Lit4Lii4LiX4Li14LmI4Liq4Li44LiU4LmD4Liq4LmI4LiB4LmI4Lit4LiZ"))() (Lowest Attack -> Lowest Price -> Lowest Level)
        table.sort(candidates, function(a, b)
            if a.Power ~= b.Power then
                return a.Power < b.Power
            end
            if a.Price ~= b.Price then
                return a.Price < b.Price
            end
            return a.Level < b.Level
        end)

        -- คำนวณจำนวนมดที่ต้องใส่ให้ loadstring(base64decode("4Lie4Lit4LiU4Li14LiB4Lix4Lia4LiX4Li14LmI4LiV4LmJ4Lit4LiH4LiB4Liy4Lij"))() (ไม่ใส่เกินมูลค่าที่ขาดอยู่)
        local remainingNeeded = status.RemainingNeeded
        if remainingNeeded <= 0 and status.NeedValue <= 0 then
            remainingNeeded = 1e8 -- 100M fallback
        end

        local itemsToDeposit = {}
        local selections = {}
        local addedCount = 0
        local totalValueSelected = 0

        for _, item in ipairs(candidates) do
            if Config.AutoCompostExactAmount and remainingNeeded <= 0 then
                break -- มูลค่ามดที่คัดเลือกครบตามเป้าหมายของตู้แล้ว! หยุดคัดเลือกทันที ไม่ใส่เกิน
            end

            local depositCount = item.Count
            if Config.AutoCompostExactAmount and remainingNeeded > 0 and item.Price > 0 then
                local countNeeded = math.ceil(remainingNeeded / item.Price)
                depositCount = math.clamp(countNeeded, 1, item.Count)
            end

            table.insert(itemsToDeposit, { V = item.V, Count = depositCount })
            selections[tostring(item.V)] = depositCount
            addedCount = addedCount + depositCount

            local itemVal = depositCount * item.Price
            totalValueSelected = totalValueSelected + itemVal
            remainingNeeded = remainingNeeded - itemVal

            if #itemsToDeposit >= 25 then
                break -- ส่งชุดละไม่เกิน 25 รายการเพื่อความรวดเร็วและป้องกันหลุด
            end
        end

        if #itemsToDeposit > 0 then
            -- 1. ยิง ECS Command ไปยัง Server เพื่อใส่มดลงตู้แปลงทรัพยากร
            sendEcsCommand(loadstring(base64decode("Q29tcG9zdEFkZEFudHM="))(), { Items = itemsToDeposit })

            -- 2. สั่งผ่าน Client CompostModel เพื่ออัปเดต UI ทันที
            pcall(function()
                local CompostModel = require(ReplicatedStorage.UI.Compost.Model.CompostModel)
                if CompostModel and CompostModel.AddAnts then
                    CompostModel:AddAnts(nil, selections)
                end
            end)

            Config.Stats.TotalCompostAntsAdded = (Config.Stats.TotalCompostAntsAdded or 0) + addedCount
            task.wait(0.15)
        end


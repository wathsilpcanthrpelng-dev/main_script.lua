-- Discard all owned ants with EFF less than currently equipped team
local function discardWeakerAnts()
    local equippedStats = getCurrentEquippedStats()
    -- หากทีมยังไม่เต็มช่องที่ปลดล็อกไว้ หรือยังไม่มีมดในทีม ให้พยายามใส่ตัวที่ดีที่สุดก่อน และไม่ทิ้งมด
    if equippedStats.EquippedCount < equippedStats.MaxSlots or equippedStats.MinEFF <= 0 or equippedStats.EquippedCount == 0 then
        triggerEquipBest()
        return
    end

    pcall(function()
        local BackpackModel = require(ReplicatedStorage.UI.Backpack.Model.BackpackModel)
        if not BackpackModel or not BackpackModel.BuildBackPackEntries then return end

        local roomIdx = LocalPlayer:GetAttribute(loadstring(base64decode("Um9vbUluZGV4"))()) or 1
        local entries = BackpackModel:BuildBackPackEntries()
        for _, entry in ipairs(entries) do
            if entry and entry.Kind == loadstring(base64decode("QW50"))() and not entry.Favorite then
                local antEff = tonumber(entry.Attack) or 0
                if antEff <= 0 and entry.V and BackpackModel.DecodeBackpackValue then
                    local uIdx, tagId, exp = BackpackModel:DecodeBackpackValue(entry.V)
                    local uKey = loadstring(base64decode("VW5pdA=="))() .. tostring(uIdx)
                    local baseAtk = battle_tbunit[uKey] and battle_tbunit[uKey].Attack or 0
                    local tagMul = battle_tbtag[tagId] and battle_tbtag[tagId].Mul or 1
                    antEff = math.ceil(baseAtk * tagMul)
                end
                -- If this ant's EFF is less than the weakest equipped ant in our team:
                if antEff > 0 and antEff < equippedStats.MinEFF then
                    local reqId = HttpService:GenerateGUID(false)
                    if EventBusRemote then
                        EventBusRemote:FireServer(loadstring(base64decode("RGlzY2FyZEhlbGRBbnQ="))(), {
                            RequestId = reqId,
                            RoomIndex = roomIdx,
                            Kind = loadstring(base64decode("QW50"))(),
                            V = entry.V,
                            EntryKey = entry.EntryKey
                        })
                    else
                        local EventBus = require(ReplicatedStorage.Packages.EventBus)
                        EventBus.FireServer(loadstring(base64decode("RGlzY2FyZEhlbGRBbnQ="))(), {
                            RequestId = reqId,
                            RoomIndex = roomIdx,
                            Kind = loadstring(base64decode("QW50"))(),
                            V = entry.V,
                            EntryKey = entry.EntryKey
                        })
                    end
                    Config.Stats.TotalDiscardedTrash = Config.Stats.TotalDiscardedTrash + 1
                    task.wait(0.08)
                end
            end
        end
    end)

    -- Trigger the Trash Can [E] Give Up prompt in the room
    pcall(function()
        for prompt in pairs(cachedRubbishPrompts) do
            if prompt and prompt.Parent and prompt.Enabled and fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end
    end)
end


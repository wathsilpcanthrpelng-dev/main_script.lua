local function applyFastFlags()
    if not Config.FastFlagsOptimized then return end
    pcall(function()
        local setFlag = setfflag or set_fflag
        if setFlag then
            for flag, val in pairs(FastFlags) do
                pcall(setFlag, flag, tostring(val))
            end
        end
    end)
end

local function boostFPS(enable)
    pcall(function()
        if enable then
            -- 1. นำ FFlags ไปใช้กับเอนจินเกม
            applyFastFlags()

            -- 2. ปิดกราฟิกและเอฟเฟกต์ทั้งหมดตามที่ระบุใน FFlags
            Lighting.GlobalShadows = false
            Lighting.ShadowSoftness = 0
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA(loadstring(base64decode("UG9zdEVmZmVjdA=="))()) or v:IsA(loadstring(base64decode("U3VuUmF5c0VmZmVjdA=="))()) or v:IsA(loadstring(base64decode("Qmxvb21FZmZlY3Q="))()) or v:IsA(loadstring(base64decode("Qmx1ckVmZmVjdA=="))()) or v:IsA(loadstring(base64decode("Q29sb3JDb3JyZWN0aW9uRWZmZWN0"))()) or v:IsA(loadstring(base64decode("RGVwdGhPZkZpZWxkRWZmZWN0"))()) then
                    v.Enabled = false
                end
            end
            local ter = Workspace:FindFirstChildOfClass(loadstring(base64decode("VGVycmFpbg=="))())
            if ter then
                ter.WaterWaveSize = 0
                ter.WaterWaveSpeed = 0
                ter.WaterReflectance = 0
                ter.WaterTransparency = 0
                pcall(function() ter.Decoration = false end)
            end
            pcall(function()
                Workspace.GlobalWind = Vector3.zero
            end)
            pcall(function()
                if settings and settings().Rendering then
                    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                end
            end)

            -- 3. ล็อค FPS ตามที่ตั้งค่าไว้ใน Config
            if setfpscap then
                local targetFps = (Config.LockFPS and tonumber(Config.TargetFPS)) or 30
                pcall(setfpscap, targetFps)
            end
        else
            Lighting.GlobalShadows = true
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA(loadstring(base64decode("UG9zdEVmZmVjdA=="))()) then
                    v.Enabled = true
                end
            end
            if setfpscap then
                pcall(setfpscap, 60)
            end
        end
    end)
end


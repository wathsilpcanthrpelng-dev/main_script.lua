-- 3.5. EVENT COOLDOWN MANAGER (ระบบตรวจสอบคูลดาวน์อีเวนต์ 5 นาที)
-- ══════════════════════════════════════════════════════════════════
-- เมื่อลงอีเวนต์ไหนเสร็จแล้ว จะบันทึกคูลดาวน์ 5 นาที (300 วินาที)
-- ระบบจะตรวจสอบและข้ามอีเวนต์ที่ติดคูลดาวน์ทันที ไม่วิ่งซ้ำจนกว่าจะครบ 5 นาที
local EventCooldowns = {
    Starfall = 0,
    StrawberryKing = 0,
    TravelSnail = 0,
}

local function setEventCooldown(eventName, duration)
    local cd = duration or Config.EventCooldownSeconds or 300
    EventCooldowns[eventName] = os.clock() + cd
end

local function getEventCooldownRemaining(eventName)
    local expire = EventCooldowns[eventName] or 0
    local remaining = expire - os.clock()
    return math.max(math.ceil(remaining), 0)
end

local function isEventOnCooldown(eventName)
    if not Config.EnableEventCooldowns then return false end
    return getEventCooldownRemaining(eventName) > 0
end

local function formatCooldownDisplay(remaining)
    if remaining <= 0 then return loadstring(base64decode("4Lie4Lij4LmJ4Lit4Lih4Lil4LiH4LiX4Lix4LiZ4LiX4Li1"))() end
    local mins = math.floor(remaining / 60)
    local secs = remaining % 60
    return string.format(loadstring(base64decode("JTAyZDolMDJkIOC4meC4suC4l+C4tQ=="))(), mins, secs)
end

local function resetAllEventCooldowns()
    for name in pairs(EventCooldowns) do
        EventCooldowns[name] = 0
    end
end

local function resetEventCooldown(eventName)
    if EventCooldowns[eventName] then
        EventCooldowns[eventName] = 0
    end
end


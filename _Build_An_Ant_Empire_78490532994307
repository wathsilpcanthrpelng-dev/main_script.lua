    local prompt = findStarEnterPrompt()
    if not prompt or not prompt.Parent or not prompt.Enabled then
        return false
    end

    -- 2. ถ้าไม่ได้ติดข้อความแจ้งเตือน loadstring(base64decode("WW91IGhhdmUgYWxyZWFkeSBjaGFsbGVuZ2VkIHRoZSBkdW5nZW9uLg=="))() ก็ลงได้เลยทันที (ไม่ต้องจับเวลา)
    if not dungeonAlreadyChallengedActive then

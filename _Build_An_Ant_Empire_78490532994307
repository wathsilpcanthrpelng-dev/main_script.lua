local function registerPrompt(prompt)
    if not prompt:IsA(loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))()) then return end
    local name = prompt.Name
    local objText = string.lower(prompt.ObjectText or loadstring(base64decode(""))())
    local actText = string.lower(prompt.ActionText or loadstring(base64decode(""))())

    -- Strawberry King Event Coins
    if string.find(objText, loadstring(base64decode("c3RyYXdiZXJyeQ=="))()) or name == loadstring(base64decode("QWN0aXZpdHlDb2luUHJvbXB0"))() or (string.find(objText, loadstring(base64decode("Y29pbg=="))()) and string.find(actText, loadstring(base64decode("cGljaw=="))())) then
        cachedStrawberryCoinPrompts[prompt] = true
        cachedCoinPrompts[prompt] = true
        -- มีเหรียญเกิดใหม่ให้รีบไปเก็บเรื่อยๆ ทันที (มี Debounce ป้องกันสแปม Coroutine ซ้อนกัน)
        if Config.AutoSweepStrawberryCoins then
            requestSweepStrawberryCoins()
        end
    elseif name == loadstring(base64decode("Q2xhaW1Sb2xsZWRBbnRQcm9tcHQ="))() then
        cachedClaimPrompts[prompt] = true
    elseif prompt.ActionText == loadstring(base64decode("R2V0"))() or (prompt.Parent and prompt.Parent.Name == loadstring(base64decode("UHJvbXB0"))()) then
        cachedFoodGetPrompts[prompt] = true
    elseif prompt.Parent and prompt.Parent.Name == loadstring(base64decode("U2VsbFByb21wdA=="))() then
        cachedFoodSellPrompts[prompt] = true
    elseif (prompt.Parent and prompt.Parent.Name == loadstring(base64decode("UnViYmlzaA=="))()) or prompt.ActionText == loadstring(base64decode("R2l2ZSBVcA=="))() or string.find(actText, loadstring(base64decode("Z2l2ZSB1cA=="))()) then
        cachedRubbishPrompts[prompt] = true
    else
        local act = string.lower(prompt.ActionText or loadstring(base64decode(""))())
        local pName = string.lower(prompt.Parent and prompt.Parent.Name or loadstring(base64decode(""))())

        -- แยกแยะอย่างชัดเจนระหว่าง ถ้ำดันเจี้ยนสัตว์เลี้ยง (Pet Dungeon Cave) vs น้ำพุดาวตก (Starfall) vs หอยทาก (Travel Snail)
        local isPetDungeon = false
        local petDungeonModel = nil
        local isStar = false
        local isSnail = false

        local curr = prompt.Parent
        while curr and curr ~= Workspace do
            local cName = string.lower(curr.Name)
            if curr:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))()) or cName == loadstring(base64decode("ZHVuZ2VvbmVudHJhbmNlcw=="))() or string.find(cName, loadstring(base64decode("cGV0ZHVuZ2Vvbg=="))()) then
                isPetDungeon = true
                if curr:IsA(loadstring(base64decode("TW9kZWw="))()) and (curr:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))()) or string.find(cName, loadstring(base64decode("cGV0ZHVuZ2Vvbg=="))())) then
                    petDungeonModel = curr
                end
                break
            elseif string.find(cName, loadstring(base64decode("c3RhcmV2ZW50"))()) or string.find(cName, loadstring(base64decode("c3RhcmZhbGw="))()) then
                isStar = true
                break
            elseif string.find(cName, loadstring(base64decode("dHJhdmVsc25haWw="))()) or string.find(cName, loadstring(base64decode("c25haWw="))()) or string.find(cName, loadstring(base64decode("dHJhdmVs"))()) or string.find(cName, loadstring(base64decode("6JyX54mb"))()) then
                isSnail = true
                break
            end
            curr = curr.Parent
        end

        if not isPetDungeon and not isStar and not isSnail then
            local pPart = prompt.Parent
            if pPart and pPart:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then
                local dist = (pPart.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude
                if dist <= 45 then
                    isStar = true
                end
            end
            if prompt.Parent and prompt.Parent.Parent then
                local ancestor = prompt.Parent.Parent
                if ancestor:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))()) or ancestor:FindFirstChild(loadstring(base64decode("RHVuZ2Vvbkd1aQ=="))()) then
                    isPetDungeon = true
                    petDungeonModel = ancestor
                end
            end
        end

        if isPetDungeon then
            if string.find(act, loadstring(base64decode("ZW50ZXI="))()) or string.find(pName, loadstring(base64decode("cHJvbXQ="))()) or string.find(pName, loadstring(base64decode("ZW50ZXI="))()) or name == loadstring(base64decode("RW50ZXJwcm9tdA=="))() or name == loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))() then
                cachedPetDungeonPrompts[prompt] = petDungeonModel or prompt.Parent
            end
        elseif isStar then
            if string.find(act, loadstring(base64decode("ZmxpcA=="))()) or string.find(pName, loadstring(base64decode("ZmxpcA=="))()) or (string.find(act, loadstring(base64decode("c3Rhcg=="))()) and string.find(pName, loadstring(base64decode("cHJvbXQ="))())) then
                cachedFlipPrompt = prompt
            elseif string.find(act, loadstring(base64decode("ZW50ZXI="))()) or string.find(pName, loadstring(base64decode("ZW50ZXI="))()) or name == loadstring(base64decode("RW50ZXJwcm9tdA=="))() then
                cachedStarEnterPrompt = prompt
            end
        elseif isSnail or string.find(objText, loadstring(base64decode("c25haWw="))()) or string.find(actText, loadstring(base64decode("c25haWw="))()) then
            if string.find(act, loadstring(base64decode("ZW50ZXI="))()) or string.find(pName, loadstring(base64decode("ZW50ZXI="))()) then
                cachedSnailEnterPrompt = prompt
            end
        else
            if string.find(act, loadstring(base64decode("ZmxpcA=="))()) or string.find(pName, loadstring(base64decode("ZmxpcA=="))()) then
                cachedFlipPrompt = prompt
            elseif string.find(act, loadstring(base64decode("ZW50ZXI="))()) or string.find(pName, loadstring(base64decode("ZW50ZXI="))()) then
                local pPart = prompt.Parent
                if pPart and pPart:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) and (pPart.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude <= 45 then
                    cachedStarEnterPrompt = prompt
                else
                    cachedSnailEnterPrompt = prompt
                end
            end
        end
    end
end


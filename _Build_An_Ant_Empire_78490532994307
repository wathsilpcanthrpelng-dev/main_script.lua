local lastStrawberryWheelSpinTime = 0
local lastStrawberryBaseBuyTime = 0

local function isStrawberryKingActive()
    local curAct = Workspace:GetAttribute(loadstring(base64decode("Q3VycmVudEFjdGl2aXR5SWQ="))()) or Workspace:GetAttribute(loadstring(base64decode("QWN0aXZpdHlJZA=="))())

local isSweepingStrawberryCoins = false

local function getAllAvailableStrawberryCoins()
    local coins = {}
    local seen = {}

    -- ดึงจากแคช cachedStrawberryCoinPrompts โดยตรง (Zero Lag O(K) ไม่ต้องสแกน Workspace ทั้งแมพ)
    for prompt in pairs(cachedStrawberryCoinPrompts) do
        if prompt and prompt.Parent and prompt.Enabled then
            local part = prompt.Parent:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA(loadstring(base64decode("QmFzZVBhcnQ="))(), true)
            if part and not seen[prompt] then
                seen[prompt] = true
                local entityId = prompt.Parent:GetAttribute(loadstring(base64decode("U3RyYXdiZXJyeUNvaW5FbnRpdHlJZA=="))()) or (part and part:GetAttribute(loadstring(base64decode("U3RyYXdiZXJyeUNvaW5FbnRpdHlJZA=="))()))
                table.insert(coins, { prompt = prompt, part = part, entityId = entityId })
            end
        else
            cachedStrawberryCoinPrompts[prompt] = nil
        end
    end

    return coins
end

sweepStrawberryCoins = function()
    if not Config.AutoSweepStrawberryCoins then return end
    if isSweepingStrawberryCoins then return end

    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))()) or char:FindFirstChild(loadstring(base64decode("VG9yc28="))()))
    if not hrp then return end

    isSweepingStrawberryCoins = true
    pcall(function()
        local originalCFrame = hrp.CFrame
        local anyCollected = false

        -- ลูปเก็บเหรียญให้หมดเกลี้ยง ถ้ามีเหรียญเกิดใหม่ระหว่างนี้ก็เก็บต่อเรื่อยๆ ทันที
        local consecutiveEmpty = 0
        while consecutiveEmpty < 2 do
            if not Config.AutoSweepStrawberryCoins then break end

            local coins = getAllAvailableStrawberryCoins()
            if #coins == 0 then
                consecutiveEmpty = consecutiveEmpty + 1
                if consecutiveEmpty < 2 then
                    task.wait(0.12) -- รอเช็กเผื่อมีเหรียญชุดใหม่กำลังตกถึงพื้น
                end
            else
                consecutiveEmpty = 0
                -- เรียงลำดับเก็บจากเหรียญที่ใกล้ตัวที่สุดไปไกลที่สุด เพื่อความเร็วสูงสุด
                table.sort(coins, function(a, b)
                    return (hrp.Position - a.part.Position).Magnitude < (hrp.Position - b.part.Position).Magnitude
                end)

                for _, coin in ipairs(coins) do
                    if not Config.AutoSweepStrawberryCoins then break end
                    if coin.prompt and coin.prompt.Parent and coin.part and coin.part.Parent then
                        anyCollected = true
                        -- วาร์ปเข้าหาเหรียญ
                        hrp.CFrame = coin.part.CFrame + Vector3.new(0, 1.8, 0)
                        task.wait(0.05)

                        pcall(function()
                            coin.prompt.Enabled = true
                            coin.prompt.HoldDuration = 0
                            coin.prompt.RequiresLineOfSight = false
                            coin.prompt.MaxActivationDistance = 99999
                            if fireproximityprompt then
                                fireproximityprompt(coin.prompt)
                            end
                            if firesignal then
                                firesignal(coin.prompt.Triggered, LocalPlayer)
                            end
                        end)

                        if coin.entityId then
                            sendEcsCommand(loadstring(base64decode("UGlja3VwU3RyYXdiZXJyeUNvaW4="))(), { CoinEntityId = coin.entityId })
                        end

                        Config.Stats.TotalStrawberryCoins = (Config.Stats.TotalStrawberryCoins or 0) + 1
                        task.wait(0.2) -- เว้นระยะห่าง 0.2 วินาทีระหว่างการเก็บแต่ละเหรียญ ตามที่ผู้ใช้ระบุ
                    end
                end
            end
        end

        -- วาร์ปกลับจุดเดิมเมื่อเก็บเหรียญบนแมพหมดเกลี้ยงแล้ว
        if anyCollected and hrp and originalCFrame then
            task.wait(0.08)
            hrp.CFrame = originalCFrame
        end
    end)

    isSweepingStrawberryCoins = false
end


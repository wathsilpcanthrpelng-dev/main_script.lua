local function enterStarDungeon()
    -- ถ้าภาพประตูหายไปแล้ว แปลว่าประตูปิด/รอบเก่าจบแล้ว ไม่ต้องกด Enter แต่ให้ไปหยอดดาวแทน
    if not isStarPortalVortexVisible() then
        dungeonAlreadyChallengedActive = false
        lastChallengedDungeonPrompt = nil
        return false
    end

    local prompt = findStarEnterPrompt()
    if not prompt or not prompt.Enabled then return false end

    -- ถ้าเป็นดันเจี้ยนเดิมที่ติดข้อความแจ้งเตือน loadstring(base64decode("WW91IGhhdmUgYWxyZWFkeSBjaGFsbGVuZ2VkIHRoZSBkdW5nZW9uLg=="))() และยังไม่รีเซ็ต ให้ข้ามไปลงดันอื่น
    if dungeonAlreadyChallengedActive and not isNewStarDungeonAvailable() then
        return false
    end

    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))()) or char:FindFirstChild(loadstring(base64decode("VG9yc28="))()))
    if not hrp then return false end

    local entered = false
    lastAttemptedDungeonType = loadstring(base64decode("U3RhckV2ZW50"))()
    lastAttemptedPrompt = prompt

    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 99999
        prompt.RequiresLineOfSight = false

        -- วาร์ปตัวละครเข้าไปในเสาประตูมิติน้ำพุดาวตกพอดี
        local pPart = prompt.Parent
        if pPart and pPart:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) and (pPart.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude <= 50 then
            hrp.CFrame = pPart.CFrame + Vector3.new(0, 1.5, 0)
        else
            hrp.CFrame = FOUNTAIN_PAD_CFRAME
        end
        task.wait(0.15)

        triggerStarPrompt(prompt)

        -- ล็อกตัวละครไว้ที่ประตูมิติและรอจนกว่าเซิร์ฟเวอร์จะโหลดเข้าดันเจี้ยน (ป้องกันระบบอื่นแย่งวาร์ปตัวละครออกไป)
        local deadline = os.clock() + 2.5
        while os.clock() < deadline do
            local sess = LocalPlayer:GetAttribute(loadstring(base64decode("RHVuZ2VvblNlc3Npb25JZA=="))())
            if sess then
                entered = true
                lastDungeonTypeEntered = loadstring(base64decode("U3RhckV2ZW50"))()
                Config.Stats.TotalDungeonsEntered = (Config.Stats.TotalDungeonsEntered or 0) + 1
                -- เข้าดันเจี้ยนได้ทันที ไม่ต้องจับเวลาหรือตั้งคูลดาวน์เวลาใดๆ
                pcall(function()
                    local EventBus = require(ReplicatedStorage.Packages.EventBus)
                    EventBus.Fire(loadstring(base64decode("RHVuZ2VvblN0YXJ0UmVxdWVzdGVk"))())
                    sendEcsCommand(loadstring(base64decode("RHVuZ2VvbkNvbW1hbmQ="))(), { Action = loadstring(base64decode("U3RhcnQ="))(), SessionId = sess })
                end)
                return
            end

            -- ถ้าติดข้อความแจ้งเตือนว่าลงไปแล้ว ให้ออกจากลูปทันที
            if dungeonAlreadyChallengedActive then
                break
            end

            if hrp and prompt.Parent and prompt.Parent:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then
                hrp.CFrame = prompt.Parent.CFrame + Vector3.new(0, 1, 0)
            end
            triggerStarPrompt(prompt)
            task.wait(0.25)
        end
    end)

    if entered then
        return true
    end

    -- ตรวจสอบว่าติดข้อความ loadstring(base64decode("WW91IGhhdmUgYWxyZWFkeSBjaGFsbGVuZ2VkIHRoZSBkdW5nZW9uLg=="))() หรือไม่
    if dungeonAlreadyChallengedActive then
        return false
    end

    -- สแกนดู Alert บนหน้าจอเฉพาะใน NezaAlertGui เพื่อความรวดเร็วและไม่กินสเปค
    pcall(function()
        local pg = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))())
        local alertGui = pg and (pg:FindFirstChild(loadstring(base64decode("TmV6YUFsZXJ0R3Vp"))()) or pg:FindFirstChild(loadstring(base64decode("YWxlcnQ="))()))
        if alertGui then
            for _, v in ipairs(alertGui:GetDescendants()) do
                if v:IsA(loadstring(base64decode("VGV4dExhYmVs"))()) and string.find(string.lower(v.Text or loadstring(base64decode(""))()), loadstring(base64decode("YWxyZWFkeSBjaGFsbGVuZ2Vk"))()) then
                    onDungeonAlreadyChallengedDetected(loadstring(base64decode("U3RhckV2ZW50"))(), prompt)
                    break
                end
            end
        end
    end)

    return (LocalPlayer:GetAttribute(loadstring(base64decode("RHVuZ2VvblNlc3Npb25JZA=="))()) ~= nil)
end


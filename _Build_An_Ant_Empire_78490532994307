-- Comprehensive currency suffix parser (handles K, M, B, T, Qa, Qi, Sx, Sp, Oc, N, D, Ud, Dd, Td, Qt, Qd, Sd, St, Od, Nod, V, Cv)
local function parseFormattedCurrency(str)
    if not str or type(str) ~= loadstring(base64decode("c3RyaW5n"))() or str == loadstring(base64decode(""))() then return nil end
    local clean = string.gsub(str, loadstring(base64decode("WywlcyUkJStd"))(), loadstring(base64decode(""))())
    if clean == loadstring(base64decode(""))() then return nil end

    local units = {
        {loadstring(base64decode("Y3Y="))(), 1e66}, {loadstring(base64decode("dg=="))(), 1e63}, {loadstring(base64decode("bm9k"))(), 1e60}, {loadstring(base64decode("b2Q="))(), 1e57},
        {loadstring(base64decode("c3Q="))(), 1e54}, {loadstring(base64decode("c2Q="))(), 1e51}, {loadstring(base64decode("cWQ="))(), 1e48}, {loadstring(base64decode("cXQ="))(), 1e45},
        {loadstring(base64decode("dGQ="))(), 1e42}, {loadstring(base64decode("ZGQ="))(), 1e39}, {loadstring(base64decode("dWQ="))(), 1e36}, {loadstring(base64decode("ZA=="))(), 1e33},
        {loadstring(base64decode("bg=="))(), 1e30},  {loadstring(base64decode("b2M="))(), 1e27}, {loadstring(base64decode("c3A="))(), 1e24}, {loadstring(base64decode("c3g="))(), 1e21},
        {loadstring(base64decode("cWk="))(), 1e18}, {loadstring(base64decode("cWE="))(), 1e15}, {loadstring(base64decode("dA=="))(), 1e12}, {loadstring(base64decode("Yg=="))(), 1e9},
        {loadstring(base64decode("bQ=="))(), 1e6},   {loadstring(base64decode("aw=="))(), 1e3}
    }

    local lower = string.lower(clean)
    for _, u in ipairs(units) do
        local suffix = u[1]
        local mult = u[2]
        if string.sub(lower, -#suffix) == suffix then
            local numPart = string.sub(clean, 1, -#suffix - 1)
            local n = tonumber(numPart)
            if n then
                return n * mult
            end
        end
    end


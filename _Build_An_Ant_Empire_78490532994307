-- ตรวจสอบว่าภาพเอฟเฟกต์ประตูมิติดาวตก (Portal Vortex) ยังแสดงอยู่หรือไม่
-- ตัวเกม: เมื่อเปิดประตู Portal.Parent = StarEvent, เมื่อประตูปิด/ภาพประตูหาย Portal.Parent = nil
isStarPortalVortexVisible = function()
    local starModel = Workspace:FindFirstChild(loadstring(base64decode("U3RhckV2ZW50"))())
    if not starModel then return false end

    local portal = starModel:FindFirstChild(loadstring(base64decode("UG9ydGFs"))())
    if not portal or portal.Parent ~= starModel then
        return false
    end

    -- ตรวจสอบว่ามีเอฟเฟกต์ภาพประตูเปิดทำงานอยู่จริงหรือไม่
    local hasVisual = false
    for _, desc in ipairs(portal:GetDescendants()) do
        if (desc:IsA(loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))()) and desc.Enabled) or (desc:IsA(loadstring(base64decode("QmVhbQ=="))()) and desc.Enabled) or (desc:IsA(loadstring(base64decode("UG9pbnRMaWdodA=="))()) and desc.Enabled) then
            hasVisual = true
            break
        elseif (desc:IsA(loadstring(base64decode("TWVzaFBhcnQ="))()) or desc:IsA(loadstring(base64decode("QmFzZVBhcnQ="))())) and desc.Transparency < 0.9 then
            hasVisual = true
            break
        end
    end
    if not hasVisual then
        return false
    end

    -- ตรวจสอบ ClockTimer (ถ้าภาพประตูหาย ClockTimer จะซ่อนตัว และแสดง Count 0/30 แทน)
    local clockLbl = starModel:FindFirstChild(loadstring(base64decode("Q2xvY2tUaW1lcg=="))(), true)
    if clockLbl and clockLbl.Visible then
        return true
    end

    return hasVisual
end


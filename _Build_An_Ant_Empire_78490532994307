getDungeonCooldownSeconds = function()
    -- 1. ตรวจสอบ NextActivityCountdownSeconds จาก Workspace (เวลาเริ่มกิจกรรมรอบถัดไป เช่น 2:42 = 162 วิ)
    local nextCd = tonumber(Workspace:GetAttribute(loadstring(base64decode("TmV4dEFjdGl2aXR5Q291bnRkb3duU2Vjb25kcw=="))()) or 0) or 0
    if nextCd > 0 then
        return nextCd
    end

    -- 2. ตรวจสอบ CurrentActivityCountdownSeconds จาก Workspace
    local curCd = tonumber(Workspace:GetAttribute(loadstring(base64decode("Q3VycmVudEFjdGl2aXR5Q291bnRkb3duU2Vjb25kcw=="))()) or 0) or 0
    if curCd > 0 then
        return curCd
    end

    -- 3. ตรวจสอบ ClockTimer บนหัวน้ำพุ (Direct path: เร็วระดับ O(1) ไม่ใช้ GetDescendants)
    local parsedFountainClock = nil
    pcall(function()
        local starModel = Workspace:FindFirstChild(loadstring(base64decode("U3RhckV2ZW50"))())
        if starModel then
            local clockLbl = starModel:FindFirstChild(loadstring(base64decode("Q2xvY2tUaW1lcg=="))(), true)
            if clockLbl and clockLbl:IsA(loadstring(base64decode("VGV4dExhYmVs"))()) and clockLbl.Visible then
                local m, s = string.match(clockLbl.Text, loadstring(base64decode("KCVkKyk6KCVkKyk="))())
                if m and s then
                    local secs = tonumber(m) * 60 + tonumber(s)
                    if secs > 0 then
                        parsedFountainClock = secs
                    end
                end
            end
        end
    end)
    if parsedFountainClock and parsedFountainClock > 0 then
        return parsedFountainClock
    end

    -- 4. ตรวจสอบ TextLabel ในหน้าจอ HUD จาก Direct path (ไม่ใช้ GetDescendants ทั้ง PlayerGui)
    local parsedHudClock = nil
    pcall(function()
        local pg = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))())
        local hud = pg and pg:FindFirstChild(loadstring(base64decode("SFVEQ29udGFpbmVy"))())
        local panel = hud and hud:FindFirstChild(loadstring(base64decode("SFVEUGFuZWw="))())
        local top = panel and panel:FindFirstChild(loadstring(base64decode("VG9w"))())
        local actTime = top and top:FindFirstChild(loadstring(base64decode("QWN0aXZpdHlUaW1l"))())
        local lbl = actTime and actTime:FindFirstChild(loadstring(base64decode("QWN0aXZpdHlUaW1lTGFiZWw="))())
        if lbl and lbl:IsA(loadstring(base64decode("VGV4dExhYmVs"))()) and lbl.Visible then
            local m, s = string.match(lbl.Text, loadstring(base64decode("KCVkKyk6KCVkKyk="))())
            if m and s then
                local secs = tonumber(m) * 60 + tonumber(s)
                if secs > 0 then
                    parsedHudClock = secs
                end
            end
        end
    end)
    if parsedHudClock and parsedHudClock > 0 then
        return parsedHudClock
    end

    return Config.EventCooldownSeconds or 300
end


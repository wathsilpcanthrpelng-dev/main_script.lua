    local cost = nil
    local isMax = false

    -- 1. Try PlayerDataHelper.GetPlayerUpgradeAttributeInfo
    pcall(function()
        local PlayerDataHelper = require(ReplicatedStorage.Battle.Game.Helper.PlayerDataHelper)
        if PlayerDataHelper and PlayerDataHelper.GetPlayerUpgradeAttributeInfo then

                    isMax = true
                elseif info.Price and tonumber(info.Price) then
                    cost = tonumber(info.Price)
                end
            end
        end
    end)
    if isMax then return nil, true end
    if cost and cost > 0 then return cost, false end

    -- 2. Try battle_tbattribute database
    pcall(function()
        local PlayerDataHelper = require(ReplicatedStorage.Battle.Game.Helper.PlayerDataHelper)
        local curLevel = 1
        if PlayerDataHelper and PlayerDataHelper.GetPlayerUpgradeAttributeLevel then
            curLevel = PlayerDataHelper.GetPlayerUpgradeAttributeLevel(LocalPlayer.UserId, chineseAttr) or 1
        end
        if battle_tbattribute and battle_tbattribute[chineseAttr] and battle_tbattribute[chineseAttr].Info then
            local infoList = battle_tbattribute[chineseAttr].Info
            for _, entry in ipairs(infoList) do
                if entry.Level == curLevel then
                    if entry.Price == 0 or entry.Price == nil then
                        isMax = true
                    else
                        cost = tonumber(entry.Price)
                    end
                    break
                end
            end
        end
    end)
    if isMax then return nil, true end
    if cost and cost > 0 then return cost, false end

    -- 3. Try reading room GUI row text (NestGui or SummonGui)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))())

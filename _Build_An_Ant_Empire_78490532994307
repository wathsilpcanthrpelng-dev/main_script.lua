-- 9.5.2. WORLD CAVE PET DUNGEON AUTOMATION (ถ้ำบอสสัตว์เลี้ยงตามแมพ ดร็อปไข่)
-- ══════════════════════════════════════════════════════════════════
findPetDungeonPrompt = function()
    -- 1. ตรวจสอบจากตารางแคช ProximityPrompt ของถ้ำบอส
    for prompt, model in pairs(cachedPetDungeonPrompts) do
        if prompt and prompt.Parent and prompt.Enabled then
            local actualModel = model
            if not (actualModel and actualModel.Parent) then
                actualModel = prompt:FindFirstAncestorWhichIsA(loadstring(base64decode("TW9kZWw="))())
            end
            local entranceId = (actualModel and actualModel:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))())) or tostring(actualModel or prompt)
            if not challengedPetDungeonIds[entranceId] then
                return prompt, actualModel
            end
        else
            cachedPetDungeonPrompts[prompt] = nil
        end
    end

    -- 2. ตรวจสอบโดยตรงในโฟลเดอร์ Workspace.DungeonEntrances
    local entrancesFolder = Workspace:FindFirstChild(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlcw=="))())
    if entrancesFolder then
        for _, model in ipairs(entrancesFolder:GetChildren()) do
            if model:IsA(loadstring(base64decode("TW9kZWw="))()) then
                local entranceId = model:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))()) or tostring(model)
                if not challengedPetDungeonIds[entranceId] then
                    local prompt = model:FindFirstChildWhichIsA(loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))(), true)
                    if prompt and prompt.Enabled then
                        cachedPetDungeonPrompts[prompt] = model
                        return prompt, model
                    end
                end
            end
        end
    end

    -- 3. ตรวจสอบโมเดล PetDungeonEntrance หรือโมเดลที่มี DungeonEntranceId ใน Workspace
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA(loadstring(base64decode("TW9kZWw="))()) and (obj:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))()) or obj.Name == loadstring(base64decode("UGV0RHVuZ2VvbkVudHJhbmNl"))() or string.find(string.lower(obj.Name), loadstring(base64decode("cGV0ZHVuZ2Vvbg=="))())) then
            local entranceId = obj:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))()) or tostring(obj)
            if not challengedPetDungeonIds[entranceId] then
                local prompt = obj:FindFirstChildWhichIsA(loadstring(base64decode("UHJveGltaXR5UHJvbXB0"))(), true)
                if prompt and prompt.Enabled then
                    cachedPetDungeonPrompts[prompt] = obj
                    return prompt, obj
                end
            end
        end
    end

    return nil, nil
end

enterPetDungeon = function()
    local prompt, model = findPetDungeonPrompt()
    if not prompt or not prompt.Enabled then
        return false
    end

    local actualModel = model or prompt:FindFirstAncestorWhichIsA(loadstring(base64decode("TW9kZWw="))())
    local entranceId = (actualModel and actualModel:GetAttribute(loadstring(base64decode("RHVuZ2VvbkVudHJhbmNlSWQ="))())) or tostring(actualModel or prompt)
    if challengedPetDungeonIds[entranceId] then
        return false
    end

    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))()) or char:FindFirstChild(loadstring(base64decode("VG9yc28="))()))
    if not hrp then return false end

    -- หาพิกัดหน้าปากถ้ำดันเจี้ยน
    local targetCFrame = nil
    if prompt.Parent and prompt.Parent:IsA(loadstring(base64decode("QmFzZVBhcnQ="))()) then
        targetCFrame = prompt.Parent.CFrame + Vector3.new(0, 1.5, 0)
    elseif actualModel and actualModel:IsA(loadstring(base64decode("TW9kZWw="))()) then
        targetCFrame = actualModel:GetPivot() + Vector3.new(0, 1.5, 0)
    end

    if not targetCFrame then return false end

    lastAttemptedDungeonType = loadstring(base64decode("UGV0"))()
    lastAttemptedPrompt = prompt
    lastDungeonTypeEntered = loadstring(base64decode("UGV0"))()

    -- วาร์ปมาหน้าปากถ้ำทันที
    pcall(function()
        hrp.CFrame = targetCFrame
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
    task.wait(0.2)

    -- บังคับปลดล็อก ProximityPrompt ให้กดติดแบบ Zero Delay
    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 99999
        prompt.RequiresLineOfSight = false
    end)

    if fireproximityprompt then
        pcall(fireproximityprompt, prompt)
    end
    if firesignal then
        pcall(firesignal, prompt.Triggered, LocalPlayer)
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end)

    -- รอตรวจจับ DungeonSessionId เมื่อเซิร์ฟเวอร์ดึงตัวเข้าดันเจี้ยน
    local entered = false
    for _ = 1, 15 do
        task.wait(0.1)
        local sess = LocalPlayer:GetAttribute(loadstring(base64decode("RHVuZ2VvblNlc3Npb25JZA=="))())
        if sess then
            entered = true
            Config.Stats.TotalDungeonsEntered = (Config.Stats.TotalDungeonsEntered or 0) + 1
            challengedPetDungeonIds[entranceId] = true
            pcall(function()
                local EventBus = require(ReplicatedStorage.Packages.EventBus)
                EventBus.Fire(loadstring(base64decode("RHVuZ2VvblN0YXJ0UmVxdWVzdGVk"))())
                sendEcsCommand(loadstring(base64decode("RHVuZ2VvbkNvbW1hbmQ="))(), { Action = loadstring(base64decode("U3RhcnQ="))(), SessionId = sess })
            end)
            break
        end

        -- ถ้าเซิร์ฟเวอร์แจ้งเตือนว่าลงไปแล้ว
        if challengedPetDungeonIds[entranceId] then
            break
        end
    end

    -- สแกนดู Alert บนหน้าจอเฉพาะใน NezaAlertGui ว่าติดข้อความ loadstring(base64decode("YWxyZWFkeSBjaGFsbGVuZ2Vk"))() หรือไม่
    if not entered then
        pcall(function()
            local pg = LocalPlayer:FindFirstChild(loadstring(base64decode("UGxheWVyR3Vp"))())
            local alertGui = pg and (pg:FindFirstChild(loadstring(base64decode("TmV6YUFsZXJ0R3Vp"))()) or pg:FindFirstChild(loadstring(base64decode("YWxlcnQ="))()))
            if alertGui then
                for _, v in ipairs(alertGui:GetDescendants()) do
                    if v:IsA(loadstring(base64decode("VGV4dExhYmVs"))()) and string.find(string.lower(v.Text or loadstring(base64decode(""))()), loadstring(base64decode("YWxyZWFkeSBjaGFsbGVuZ2Vk"))()) then
                        onDungeonAlreadyChallengedDetected(loadstring(base64decode("UGV0"))(), prompt)
                        break
                    end
                end
            end
        end)
    end

    return entered
end


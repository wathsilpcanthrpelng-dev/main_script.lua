                target.Prompt:InputHoldEnd()
            end)
            didTrigger = true
        end)
    end
    
    -- Layer 2: Send Direct ECS Commands (both RoomAntInfoGui and ProximityPrompt sources)
    sendEcsCommand(loadstring(base64decode("QWRkQW50U2xvdA=="))(), { Source = loadstring(base64decode("Um9vbUFudEluZm9HdWk="))(), RoomIndex = roomIdx, SlotIndex = slotIdx })

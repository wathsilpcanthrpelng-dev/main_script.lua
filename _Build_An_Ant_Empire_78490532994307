local function purgeCloverInstance(obj)
    if not Config.DisableClover and not Config.DisableAllParticles then return end
    if not obj:IsA(loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))()) and not obj:IsA(loadstring(base64decode("VHJhaWw="))()) and not obj:IsA(loadstring(base64decode("QmVhbQ=="))()) and not obj:IsA(loadstring(base64decode("SW1hZ2VMYWJlbA=="))()) and not obj:IsA(loadstring(base64decode("SW1hZ2VCdXR0b24="))()) then return end

    pcall(function()
        if obj:IsA(loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))()) then
            if Config.DisableAllParticles then
                obj.Enabled = false
                obj.Rate = 0
                pcall(function() obj:Clear() end)
                return
            end

            local name = string.lower(obj.Name or loadstring(base64decode(""))())
            local pName = string.lower(obj.Parent and obj.Parent.Name or loadstring(base64decode(""))())
            local tex = string.lower(obj.Texture or loadstring(base64decode(""))())

            local isMatch = false
            if string.find(name, loadstring(base64decode("Y2xvdmVy"))()) or string.find(pName, loadstring(base64decode("Y2xvdmVy"))()) or string.find(tex, loadstring(base64decode("Y2xvdmVy"))())
                or string.find(name, loadstring(base64decode("bHVjaw=="))()) or string.find(pName, loadstring(base64decode("bHVjaw=="))())
                or string.find(name, loadstring(base64decode("bGVhZg=="))()) or string.find(pName, loadstring(base64decode("bGVhZg=="))())
                or string.find(name, loadstring(base64decode("dmluZQ=="))()) or string.find(pName, loadstring(base64decode("dmluZQ=="))())
                or string.find(name, loadstring(base64decode("cmFpbg=="))()) or string.find(pName, loadstring(base64decode("cmFpbg=="))())
                or string.find(name, loadstring(base64decode("d2VhdGhlcg=="))()) or string.find(pName, loadstring(base64decode("d2VhdGhlcg=="))())
                or string.find(name, loadstring(base64decode("YW1iaWVudA=="))()) or string.find(pName, loadstring(base64decode("YW1iaWVudA=="))())
                or string.find(name, loadstring(base64decode("6I2J"))()) or string.find(name, loadstring(base64decode("5Y+2"))()) or string.find(name, loadstring(base64decode("6Jek"))()) or string.find(name, loadstring(base64decode("5bm46L+Q"))()) then
                isMatch = true
            end

            if not isMatch and Workspace.CurrentCamera and obj:IsDescendantOf(Workspace.CurrentCamera) then
                isMatch = true
            end

            if not isMatch and obj.Color then
                local kp = obj.Color.Keypoints
                if kp and #kp > 0 then
                    local c = kp[1].Value
                    if c.G > 0.4 and c.G > (c.R * 1.15) and c.G > (c.B * 1.15) then
                        isMatch = true
                    end
                end
            end

            if isMatch then
                obj.Enabled = false
                obj.Rate = 0
                pcall(function() obj:Clear() end)
            end
        elseif obj:IsA(loadstring(base64decode("VHJhaWw="))()) or obj:IsA(loadstring(base64decode("QmVhbQ=="))()) then
            local name = string.lower(obj.Name or loadstring(base64decode(""))())
            local pName = string.lower(obj.Parent and obj.Parent.Name or loadstring(base64decode(""))())
            if Config.DisableAllParticles or string.find(name, loadstring(base64decode("Y2xvdmVy"))()) or string.find(pName, loadstring(base64decode("Y2xvdmVy"))()) or string.find(name, loadstring(base64decode("bGVhZg=="))()) or string.find(name, loadstring(base64decode("dmluZQ=="))()) then
                obj.Enabled = false
            end
        elseif obj:IsA(loadstring(base64decode("SW1hZ2VMYWJlbA=="))()) or obj:IsA(loadstring(base64decode("SW1hZ2VCdXR0b24="))()) then
            local name = string.lower(obj.Name or loadstring(base64decode(""))())
            local pName = string.lower(obj.Parent and obj.Parent.Name or loadstring(base64decode(""))())
            local img = string.lower(obj.Image or loadstring(base64decode(""))())
            if string.find(name, loadstring(base64decode("Y2xvdmVy"))()) or string.find(pName, loadstring(base64decode("Y2xvdmVy"))()) or string.find(img, loadstring(base64decode("Y2xvdmVy"))())
               or string.find(name, loadstring(base64decode("bHVjaw=="))()) or string.find(pName, loadstring(base64decode("bHVjaw=="))())
               or string.find(name, loadstring(base64decode("bGVhZg=="))()) or string.find(pName, loadstring(base64decode("bGVhZg=="))())
               or string.find(name, loadstring(base64decode("6I2J"))()) or string.find(pName, loadstring(base64decode("6I2J"))()) then
                obj.Visible = false
            end
        end
    end)
